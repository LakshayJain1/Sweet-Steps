# EmailJS (for booking forms - client-side)
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics
# Get your GA4 Measurement ID from Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Notion API (for server-side booking API)
# Get these from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL (for sitemap, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=https://sweetsteps.online
---
import Layout from "../layouts/layout.astro";

export const metadata = {
  title: "Page Not Found | Sweet Steps",
  description: "The page you are looking for does not exist.",
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen flex flex-col items-center justify-center bg-neutral-50 text-neutral-900 px-6 text-center">
    <h1 class="text-6xl md:text-8xl font-heading mb-4 text-neutral-900">404</h1>
    <p class="text-xl md:text-2xl text-neutral-500 mb-8 max-w-md">The page you are looking for does not exist or has been moved.</p>
    <a href="/" class="btn-primary">Return to Home</a>
  </main>
</Layout>

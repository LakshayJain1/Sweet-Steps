---
import Layout from "../layouts/layout.astro";
import StickyHeader from "@components/layout/StickyHeader";
import BreadcrumbJsonLd from "@components/seo/BreadcrumbJsonLd";
import Footer from "@components/layout/Footer";
import ChatWidget from "@components/common/ChatWidget";
import ScrollReveal from "@components/common/ScrollReveal";
import { Gift, Heart, Users, Calendar } from "lucide-react";

export const metadata = {
  title: "Sweet Rewards | Loyalty Program",
  description: "Join the Sweet Steps loyalty program in Jaipur. Earn rewards for every referral and multiple casting sessions as your baby grows.",
  keywords: [
    "baby casting loyalty program Jaipur",
    "referral discount hand casting Jaipur",
    "repeat customer discount 3D casting Jaipur",
    "baby milestone casting discounts Jaipur",
    "family casting rewards Jaipur",
    "Sweet Steps referral program"
  ],
  canonical: "https://www.sweetsteps.online/rewards",
};
---

<Layout metadata={metadata}>
  <BreadcrumbJsonLd trail={[{ name: "Home", href: "/" }, { name: "Rewards", href: "/rewards" }]} />
  <StickyHeader client:load />
  <main class="pt-32 pb-24 bg-neutral-50 overflow-hidden relative min-h-screen">
    {/* Background Mesh */}
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-neutral-300/10 rounded-full blur-[120px] -z-10" />
    <div class="absolute bottom-20 left-0 w-[500px] h-[500px] bg-neutral-400/8 rounded-full blur-[120px] -z-10" />

    <div class="container mx-auto max-w-[1200px] px-6">
      <ScrollReveal client:load>
        <div class="text-center max-w-3xl mx-auto mb-20 space-y-6">
          <div class="inline-flex items-center justify-center p-3 bg-neutral-100 rounded-full mb-4">
            <Gift className="h-8 w-8 text-neutral-700" />
          </div>
          <h1 class="text-5xl md:text-6xl text-neutral-900">Sweet Rewards</h1>
          <p class="text-xl text-neutral-500 leading-relaxed">
            Once you join the Sweet Steps family, the magic doesn't have to stop. 
            Our loyalty program is designed to help your memories grow as your baby does.
          </p>
        </div>
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <ScrollReveal client:load delay={0}>
          <div class="glass-card p-10 flex flex-col items-center text-center group h-full">
            <div class="bg-neutral-100 text-neutral-700 rounded-full w-20 h-20 flex items-center justify-center mb-8 transition-transform duration-500 group-hover:scale-110 shadow-glass border border-neutral-200">
              <Heart className="h-10 w-10" />
            </div>
            <h3 class="text-2xl font-bold mb-4 text-neutral-900">The Growing Heart</h3>
            <p class="text-neutral-500 text-lg leading-relaxed flex-1">
              10% OFF your next casting session (6 Months, 1 Year, etc.) to capture the growth journey.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.12}>
          <div class="glass-card p-10 flex flex-col items-center text-center group h-full">
            <div class="bg-neutral-100 text-neutral-700 rounded-full w-20 h-20 flex items-center justify-center mb-8 transition-transform duration-500 group-hover:scale-110 shadow-glass border border-neutral-200">
              <Users className="h-10 w-10" />
            </div>
            <h3 class="text-2xl font-bold mb-4 text-neutral-900">Family Referral Bloom</h3>
            <p class="text-neutral-500 text-lg leading-relaxed flex-1">
              Refer a friend in Jaipur and both get a ₹1,500 voucher towards your next premium keepsake frame.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.24}>
          <div class="glass-card p-10 flex flex-col items-center text-center group h-full">
            <div class="bg-neutral-100 text-neutral-700 rounded-full w-20 h-20 flex items-center justify-center mb-8 transition-transform duration-500 group-hover:scale-110 shadow-glass border border-neutral-200">
              <Calendar className="h-10 w-10" />
            </div>
            <h3 class="text-2xl font-bold mb-4 text-neutral-900">Holiday Keepsake Priority</h3>
            <p class="text-neutral-500 text-lg leading-relaxed flex-1">
              Early access to our limited-edition Diwali and Christmas themed casting sessions.
            </p>
          </div>
        </ScrollReveal>
      </div>

      {/* Social Call to Action */}
      <ScrollReveal client:load delay={0.2}>
        <div class="mt-24 glass-panel p-12 text-center max-w-4xl mx-auto space-y-8 bg-white/30">
          <h2 class="text-3xl font-heading font-medium text-neutral-900">Want to earn your first reward?</h2>
          <p class="text-xl text-neutral-500 mb-8">
            Share your unboxing story on Instagram, tag @sweet_.steps__, 
            and get an instant discount voucher for your next family session!
          </p>
          <a 
            href="https://wa.me/918302419714?text=Hi,%20I%20shared%20my%20Sweet%20Steps%20story!%20Here%20is%20the%20link."
            class="liquid-button text-xl px-12 py-5 inline-flex items-center gap-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            Claim My Reward 🎁
          </a>
        </div>
      </ScrollReveal>
    </div>
  </main>
  <Footer client:load />
  <ChatWidget client:load />
</Layout>
